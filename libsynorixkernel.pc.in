prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: Synorix kernel library
Description: Experimental library for the Synorix validation engine.
Version: @CLIENT_VERSION_STRING@
Libs: -L${libdir} -lsynorixkernel
Cflags: -I${includedir}
